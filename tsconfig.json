{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["registry/ui/*"],
      "@/lib/*": ["registry/lib/*"],
      "@pseudonym-ui/tokens": ["packages/tokens/dist/theme.css"],
      "@pseudonym-ui/tokens/*": ["packages/tokens/dist/*"]
    }
  },
  "include": ["registry", "apps/docs/src", "test", "vitest.config.ts"]
}
