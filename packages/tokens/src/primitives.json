{
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#fafafa" },
      "100": { "$type": "color", "$value": "#f5f5f5" },
      "200": { "$type": "color", "$value": "#e5e5e5" },
      "300": { "$type": "color", "$value": "#d4d4d4" },
      "400": { "$type": "color", "$value": "#a3a3a3" },
      "600": { "$type": "color", "$value": "#525252" },
      "700": { "$type": "color", "$value": "#404040" },
      "800": { "$type": "color", "$value": "#262626" },
      "900": { "$type": "color", "$value": "#171717" },
      "950": { "$type": "color", "$value": "#0a0a0a" }
    },
    "brand": {
      "DEFAULT": { "$type": "color", "$value": "#d4ff3a" },
      "hover": { "$type": "color", "$value": "#c4f01f" },
      "text": { "$type": "color", "$value": "#4d7c0f" },
      "fill": { "$type": "color", "$value": "#a3e635" },
      "strong": { "$type": "color", "$value": "#5a940c" },
      "on": { "$type": "color", "$value": "#0a0a0a" },
      "ring": { "$type": "color", "$value": "#84cc16" },
      "muted": { "$type": "color", "$value": "rgba(212, 255, 58, 0.12)" }
    },
    "destructive": {
      "light": { "$type": "color", "$value": "#dc2626" },
      "dark": { "$type": "color", "$value": "#f87171" }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "-apple-system", "Segoe UI", "Roboto", "Arial", "sans-serif"]
    }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "8px" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "100ms" },
    "mid": { "$type": "duration", "$value": "150ms" },
    "slow": { "$type": "duration", "$value": "200ms" }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.3, 1] }
  },
  "layout": {
    "sidebar": { "$type": "dimension", "$value": "320px" },
    "topbar": { "$type": "dimension", "$value": "60px" },
    "breakpoint": { "$type": "dimension", "$value": "860px" }
  }
}
