      "card-foreground": { "$type": "color", "$value": "{color.neutral.900}" },
      "popover": { "$type": "color", "$value": "{color.neutral.0}" },
      "popover-foreground": { "$type": "color", "$value": "{color.neutral.900}" },
      "primary": { "$type": "color", "$value": "{color.brand.DEFAULT}" },
      "primary-foreground": { "$type": "color", "$value": "{color.brand.on}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.0}" },
      "secondary-foreground": { "$type": "color", "$value": "{color.neutral.700}" },
      "muted": { "$type": "color", "$value": "{color.neutral.50}" },
