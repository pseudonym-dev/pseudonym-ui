      "chart-1": { "$type": "color", "$value": "{color.brand.fill}" },
      "chart-2": { "$type": "color", "$value": "{color.brand.ring}" },
      "chart-3": { "$type": "color", "$value": "{color.brand.text}" },
      "chart-4": { "$type": "color", "$value": "{color.neutral.600}" },
      "chart-5": { "$type": "color", "$value": "{color.neutral.400}" },
      "canvas-shadow": {
        "$type": "shadow",
        "$value": "0 0 0 1px var(--border), 0 24px 48px -12px rgb(0 0 0 / 20%)"
