      "sidebar-accent-foreground": { "$type": "color", "$value": "{color.neutral.900}" },
      "sidebar-border": { "$type": "color", "$value": "{color.neutral.200}" },
      "sidebar-ring": { "$type": "color", "$value": "{color.brand.ring}" },
      "brand-hover": { "$type": "color", "$value": "{color.brand.hover}" },
      "brand-text": { "$type": "color", "$value": "{color.brand.text}" },
